# linguacraft production env template
# 拷贝: cp .env.production.example .env && nano .env
# 权限: chmod 600 .env (含真 secret, 仅 root + linguacraft 用户可读)
#
# --- 必填 (后端启动会做 fail-fast 检查, 缺失直接拒启) ---

# API listen port
API_PORT=5500

# MongoDB
MONGO_URL=mongodb://localhost:27017/linguacraft

# Redis (RateLimitGuard 走 fail-open, 缺也不挂, 但建议配)
REDIS_URL=redis://localhost:6379

# JWT secret — 强随机 64 字符
# 生成: openssl rand -hex 32
# 禁止: dev_secret_change_me / dev_secret / 长度 < 32 (启动会被拒)
JWT_SECRET=

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# CORS — prod 必填, 启动会拒启 "*" / 空值
# 多个 origin 逗号分隔, 不要带尾斜杠
ALLOWED_ORIGINS=https://app.linguacraft.com

# --- 建议配 (DeepSeek 月预算告警 + 验证码邮件, 没配告警脚本会失败) ---

# SMTP (QQ / Gmail / SendGrid 都行)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- 不要填 (这些已从 prod 流程移除) ---

# ADMIN_EMAIL 故意不列 — admin 账号走 mongo shell / 后台超管提权
# NODE_ENV=production 不要设 — 用 systemd Environment 配, 或在启动脚本里 export
