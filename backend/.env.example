# Server
API_PORT=5500

# MongoDB
MONGO_URL=mongodb://localhost:27017/linguacraft

# Redis
REDIS_URL=redis://localhost:6379

# JWT (IMPORTANT: Change this in production!)
JWT_SECRET=change_me_to_a_random_string

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 2026-06-12: ADMIN_EMAIL removed.
#   Admin accounts are managed out-of-band (mongo shell or super-admin promotion).
#   For local dev, set ADMIN_EMAIL as a shell env (NOT in .env) before `npm run dev`.

# SMTP (for sending verification codes)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM=your_email@qq.com

# 2026-06-12: CORS — comma-separated origin allowlist (no trailing slashes).
#   Dev default: unset or "*" (any origin).
#   Prod MUST be explicit, e.g. "https://app.linguacraft.com,https://admin.linguacraft.com"
# ALLOWED_ORIGINS=https://app.linguacraft.com
